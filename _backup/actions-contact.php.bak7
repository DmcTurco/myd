<?php
require_once __DIR__ . '/../config/config.php';
require_once __DIR__ . '/../includes/functions.php';

// Solo POST
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    redirect(page_url('contacto'));
}

// Honeypot anti-spam
if (!empty($_POST['website'])) {
    redirect(page_url('contacto') . '?enviado=1');
}

// Recoger y sanitizar
$nombre  = sanitize($_POST['nombre']  ?? '');
$email   = sanitize($_POST['email']   ?? '');
$telefono = sanitize($_POST['telefono'] ?? '');
$asunto  = sanitize($_POST['asunto']  ?? '');
$mensaje = sanitize($_POST['mensaje'] ?? '');

// Validación básica
$errors = [];
if (strlen($nombre) < 3)            $errors[] = 'Nombre inválido.';
if (!filter_var($email, FILTER_VALIDATE_EMAIL)) $errors[] = 'Email inválido.';
if (empty($asunto))                 $errors[] = 'Asunto requerido.';
if (strlen($mensaje) < 10)         $errors[] = 'Mensaje muy corto.';

if ($errors) {
    redirect(page_url('contacto') . '?error=1');
}

// Construir email
$subject = '[MyDSAC] Consulta: ' . $asunto;
$body = "Nuevo mensaje de contacto desde mydsac.com\n\n"
      . "Nombre:   $nombre\n"
      . "Email:    $email\n"
      . "Teléfono: $telefono\n"
      . "Asunto:   $asunto\n\n"
      . "Mensaje:\n$mensaje\n";

$headers  = "From: " . MAIL_FROM . "\r\n";
$headers .= "Reply-To: $email\r\n";
$headers .= "X-Mailer: PHP/" . phpversion();

$sent = mail(MAIL_TO, $subject, $body, $headers);

if ($sent) {
    redirect(page_url('contacto') . '?enviado=1');
} else {
    redirect(page_url('contacto') . '?error=1');
}
