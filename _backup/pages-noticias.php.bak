// Detalle de noticia
$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
$noticia_actual = null;
if ($id > 0) {
    foreach ($noticias as $n) {
        if ($n['id'] === $id) { $noticia_actual = $n; break; }
    }
}

if ($noticia_actual):
?>

<!-- ===== DETALLE DE NOTICIA ===== -->
<section class="section">
    <div class="container news-detail">
        <article class="news-article">
            <div class="news-article__header">
                <span class="news-article__cat"><?= htmlspecialchars($noticia_actual['categoria']) ?></span>
                <h1><?= htmlspecialchars($noticia_actual['titulo']) ?></h1>
                <div class="news-article__meta">
                    <span><i class="fas fa-calendar"></i> <?= $noticia_actual['fecha'] ?></span>
                    <span><i class="fas fa-user"></i> <?= htmlspecialchars($noticia_actual['autor']) ?></span>
                </div>
            </div>
            <div class="news-article__img" style="background-image:url('<?= asset('images/' . $noticia_actual['imagen']) ?>')"></div>
            <div class="news-article__body">
                <?= $noticia_actual['contenido'] ?>
            </div>
            <div class="news-article__footer">
                <a href="<?= page_url('noticias') ?>" class="btn btn--outline-dark"><i class="fas fa-arrow-left"></i> Volver a noticias</a>
            </div>
        </article>

        <!-- Sidebar -->
        <aside class="news-sidebar">
            <h4>Últimas Noticias</h4>
            <ul class="news-sidebar__list">
                <?php foreach (array_slice($noticias, 0, 5) as $n): ?>
                <li>
                    <a href="<?= page_url('noticias') ?>&id=<?= $n['id'] ?>">
                        <span class="news-sidebar__date"><?= $n['fecha'] ?></span>
                        <?= htmlspecialchars($n['titulo']) ?>
                    </a>
                </li>
                <?php endforeach; ?>
            </ul>
            <div class="news-sidebar__cta">
                <h4>¿Necesita asesoría?</h4>
                <p>Contáctenos y un especialista le atenderá sin costo.</p>
                <a href="<?= page_url('contacto') ?>" class="btn btn--primary">Contáctenos</a>
            </div>
        </aside>
    </div>
</section>

<?php else: ?>

<!-- ===== LISTADO DE NOTICIAS ===== -->
<section class="section">
    <div class="container">
        <div class="news-list news-list--single">
            <?php foreach ($noticias as $n): ?>
            <article class="news-list-card news-list-card--wide">
                <a href="<?= page_url('noticias') ?>&id=<?= $n['id'] ?>" class="news-list-card__img" style="background-image:url('<?= asset('images/' . $n['imagen']) ?>')">
                    <span class="news-list-card__play"><i class="fas fa-play"></i></span>
                </a>
                <div class="news-list-card__body">
                    <h3><a href="<?= page_url('noticias') ?>&id=<?= $n['id'] ?>"><?= htmlspecialchars($n['titulo']) ?></a></h3>
                    <div class="news-list-card__meta">
                        <span><?= $n['fecha'] ?></span>
                        <span>mydsac</span>
                        <span>M&amp;D</span>
                        <span>0 Comment</span>
                    </div>
                    <p><?= htmlspecialchars($n['resumen']) ?></p>
                </div>
            </article>
            <?php endforeach; ?>
        </div>
    </div>
</section>

<?php endif; ?>
