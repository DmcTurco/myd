/* =============================================
   SERVICES ICONS
   ============================================= */
.services-icons {
    background: var(--white);
    padding: 40px 0;
    border-bottom: 1px solid var(--border);
}
.services-icons__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
}
.services-icons__item {
    display: flex; align-items: flex-start; gap: 18px;
    padding: 20px 30px;
    border-right: 1px solid var(--border);
}
.services-icons__item:last-child { border-right: none; }
.services-icons__item i {
    font-size: 1.6rem;
    color: var(--navy);
    flex-shrink: 0;
    margin-top: 3px;
}
.services-icons__item p {
    color: var(--text-dark);
    font-family: var(--font-heading);
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 300;
}

/* =============================================
   HOME MAIN CONTENT (News + Companies)
   ============================================= */
.home-content {
    background: var(--white);
    padding: 50px 0;
}
.home-content__inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 50px;
    align-items: start;
}

.home-section-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--text-dark);
    font-weight: 300;
    margin-bottom: 8px;
}
.home-section-title + hr {
    border: none; border-top: 1px solid var(--border);
    margin-bottom: 20px;
}

/* News items */
.home-news__item {
    display: flex; gap: 18px;
    padding: 16px 0;
    align-items: flex-start;
}
.home-news__item + hr {
    border: none; border-top: 1px solid var(--border);
}
.home-news__date {
    flex-shrink: 0;
    text-align: center;
    min-width: 52px;
}
.home-news__day {
    display: block;
    font-size: 1.5rem; font-weight: 400;
    font-family: var(--font-body);
    color: #999999;
    line-height: 1;
}
.home-news__my {
    display: block;
    font-size: .75rem;
    color: #999999;
    margin-top: 2px;
}
.home-news__body h4 {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--text-dark);
    margin-bottom: 4px;
    line-height: 1.4;
}
.home-news__body h4 a:hover { color: var(--sky); }
.home-news__body p {
    font-size: .82rem;
    color: var(--text);
    line-height: 1.5;
}

/* Companies carousel */
.home-companies {}
.comp-carousel {
    border: 1px solid var(--border);
    background: var(--white);
    padding: 30px 20px;
    position: relative;
    min-height: 200px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.comp-carousel__track { width: 100%; }
.comp-carousel__slide {
    display: none;
    align-items: center; justify-content: center;
    min-height: 140px;
    flex-direction: column;
    gap: 10px;
}
.comp-carousel__slide--active { display: flex; }
.comp-carousel__slide img {
    max-height: 90px; max-width: 240px;
    object-fit: contain; margin: 0 auto;
}
.comp-carousel__name {
    font-weight: 700; color: var(--navy);
    font-size: .95rem; text-align: center;
}
.comp-carousel__dots {
    display: flex; gap: 7px; margin-top: 20px;
    justify-content: center;
}
.comp-carousel__dot {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--border); cursor: pointer;
    border: none; transition: var(--transition);
}
.comp-carousel__dot--active { background: var(--sky); }

