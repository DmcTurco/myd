# =============================================================
#  M&D Asesores Financieros — configuración de producción
#  Dominio: https://mydsac.com (sin www)
# =============================================================

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------
    #  1. HTTPS y dominio canónico (sin www)
    #     DESCOMENTA estas dos reglas al subir a producción.
    #     Déjalas comentadas mientras pruebes en localhost.
    # ---------------------------------------------------------
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # ---------------------------------------------------------
    #  2. URLs limpias
    #     Todo lo que no sea un archivo o carpeta real entra por
    #     index.php, que resuelve la ruta con config/rutas.php.
    #     Se conservan las direcciones del sitio original:
    #       /nosotros/  /servicios/  /trc/  /vida-ley/
    #       /2017/11/20/la-positiva/
    # ---------------------------------------------------------
    RewriteRule ^index\.php$ - [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?ruta=$1 [QSA,L]
</IfModule>

# -------------------------------------------------------------
#  3. Archivos que nunca deben servirse
# -------------------------------------------------------------
<FilesMatch "\.(env|log|sql|sh|bak|bak[0-9]|json|wpress|ini|yml|yaml|md)$">
    Require all denied
</FilesMatch>

# Cualquier archivo que empiece por punto (.git, .env, .htaccess...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Carpetas de código y datos: solo se usan desde PHP, no por URL
RedirectMatch 404 /(config|includes|data|vendor|_logs)/

# -------------------------------------------------------------
#  4. Cabeceras de seguridad
# -------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Actívala cuando confirmes que todo el sitio carga por https
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
</IfModule>

# -------------------------------------------------------------
#  5. Compresión
# -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# -------------------------------------------------------------
#  6. Caché del navegador
# -------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/gif     "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"
    ExpiresByType font/woff2    "access plus 1 year"
    # El CSS va con ?v=<fecha>, así que puede cachearse fuerte
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresDefault              "access plus 2 days"
</IfModule>

# -------------------------------------------------------------
#  7. PHP: no mostrar errores al visitante (sí registrarlos)
# -------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
